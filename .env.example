# ===================================================
# Environment Variables for BattleTaco.github.io
# ===================================================
# Copy this file to .env and fill in the values.
# NEVER commit your .env file to version control.
#
# cp .env.example .env
# ===================================================

# GitHub Personal Access Token (classic) with "read:user" scope
# Generate at: https://github.com/settings/tokens
REACT_APP_GITHUB_TOKEN=

# Your GitHub username (used to fetch profile & pinned repos)
GITHUB_USERNAME=BattleTaco

# Set to "true" to fetch live GitHub data, "false" to skip
USE_GITHUB_DATA=true

# Your Medium username (used to fetch blog posts)
# Leave empty or remove if you don't use Medium
MEDIUM_USERNAME=
